# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.venv/
venv/

# App-generated data
settings.json
history.json
logs/

# PyInstaller output
build/
dist/
*.spec

# Environment variables & Credentials (NEVER COMMIT TO GIT)
.env
*.env
credentials/client_secret.json
credentials/token.json
yt_shorts_automation/credentials/*.json
